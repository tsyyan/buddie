# what a push to experiment/bdx-004-run runs (job run in .github/workflows/bdx004.yml)
# 2026-11-02: the registered experiment (PROTOCOL.md): arms A, B, C, all 192 units, free gpt-oss-120b; resumable
# through the Actions cache, one chunk per push
ARMS=D
PROVIDER=groq,ovh,cloudflare
MODEL=openai/gpt-oss-120b
OUT=main-gptoss.jsonl
MINUTES=330
# 2026-11-02, owner: the 55 rows that failed at the provider were run again once (PROTOCOL.md, Changes after data);
# not again. 2026-11-02, owner: arm D runs on all 192 units (its condition is met); A, B, C rows are kept as they are
# 2026-11-02, owner rule for provider failures (run again once), applied to arm D only: its 23 failed rows
REDO_ERRORS=1
