# what a push to experiment/bdx-004-run runs (job run in .github/workflows/bdx004.yml)
# 2026-11-02: the registered experiment (PROTOCOL.md): arms A, B, C, all 192 units, free gpt-oss-120b; resumable
# through the Actions cache, one chunk per push
ARMS=A,B,C
PROVIDER=groq,ovh,cloudflare
MODEL=openai/gpt-oss-120b
OUT=main-gptoss.jsonl
MINUTES=330
# 2026-11-02, owner: the 55 rows that failed at the provider are run again (PROTOCOL.md, Changes after data)
REDO_ERRORS=1
