{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tsyyan/buddie/experiments/feedback-e2e-v1#live-approval-v1",
 "title": "A person's approval of the live phase (bench.py plan and live.py refuse without one)",
 "description": "Written and signed off by the person paying for the runs, never by an agent. A subscription plan is not an approval: the same fields apply to any model execution. live.py executes only when final_authorization is filled in.",
 "type": "object",
 "additionalProperties": false,
 "required": ["provider", "model", "repetitions", "allowed_tools", "permissions", "max_cost_usd", "sampling", "context",
              "reporting_rules", "approved_by", "approved_at", "pricing", "limits", "final_authorization"],
 "properties": {
  "provider": {"type": "string"},
  "model": {"type": "string", "description": "the exact model id; no other model may answer"},
  "repetitions": {"type": "integer", "minimum": 1, "description": "per scenario and condition (at most 50)"},
  "allowed_tools": {"type": "array", "items": {"enum": ["verify_report", "feedback_start", "feedback_resolve"]}},
  "permissions": {"type": "string"},
  "max_cost_usd": {"type": "number", "description": "the ceiling for the whole live phase"},
  "sampling": {"type": "object", "required": ["temperature", "effort"],
               "description": "temperature (null where the API takes none), effort, thinking"},
  "context": {"type": "object"},
  "reporting_rules": {"type": "string"},
  "approved_by": {"type": "string"},
  "approved_at": {"type": "string"},
  "pricing": {"type": "object", "additionalProperties": false,
              "required": ["input_per_mtok", "output_per_mtok", "cache_write_5m_per_mtok", "cache_read_per_mtok", "source", "checked_at"],
              "properties": {"input_per_mtok": {"type": "number"}, "output_per_mtok": {"type": "number"},
                             "cache_write_5m_per_mtok": {"type": "number"}, "cache_read_per_mtok": {"type": "number"},
                             "source": {"type": "string"}, "checked_at": {"type": "string"}}},
  "limits": {"type": "object", "additionalProperties": false,
             "required": ["max_cost_usd", "max_cost_per_run_usd", "max_tokens_per_call", "max_calls_per_run", "iteration_limit"],
             "properties": {"max_cost_usd": {"type": "number"}, "max_cost_per_run_usd": {"type": "number"},
                            "max_tokens_per_call": {"type": "integer", "minimum": 1},
                            "max_calls_per_run": {"type": "integer", "minimum": 1},
                            "iteration_limit": {"type": "integer", "minimum": 1}}},
  "final_authorization": {"type": "object", "additionalProperties": false, "required": ["authorized_by", "authorized_at"],
                          "properties": {"authorized_by": {"type": "string"}, "authorized_at": {"type": "string"}},
                          "description": "empty until a person authorizes the spend, after seeing the model id, the pricing basis and the cost enforcement"}
 }
}
