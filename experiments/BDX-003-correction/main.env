# what a push to experiment/bdx-003-main runs: one chunk of the main run, resumed from the previous chunk's data
# (Actions cache). Every eligible unit; a chunk stops at the providers' limits or after MINUTES.
# 2026-11-02: BDX-003 is closed (PROTOCOL). A push now only judges: no provider is named, so arms.py stops at once
PROVIDER=closed
MODEL=claude-opus-5
ARMS=A,B,C,D,E
ANTHROPIC_BASE_URL=https://api.tokenn.pro/anthropic
MAX_REQUESTS=3000
DROP_RATE_LIMITED=1
MINUTES=320
