{
  "version": 1,
  "frozen_before_scenarios": true,
  "principle": "Condition B menu. 'parity' items read the same sources buddie's collectors read (one or more per buddie category), as an engineer would type them. 'extra' items are conventional diagnostics buddie deliberately does not collect (host name, clock, PATH, disk of the working directory, WSL distributions, compute capability is NOT included: plain nvidia-smi is the conventional command). Every item is run on every environment in that environment's default shell, so a Linux command on Windows records Windows' real error.",
  "items": [
    {"id": "uname -a", "kind": "parity", "maps_to": ["system.os", "hardware.cpu"]},
    {"id": "cat /etc/os-release", "kind": "parity", "maps_to": ["system.os"]},
    {"id": "echo $SHELL", "kind": "parity", "maps_to": ["system.shell"]},
    {"id": "bash --version", "kind": "parity", "maps_to": ["system.shell"]},
    {"id": "id -u", "kind": "parity", "maps_to": ["system.permissions"]},
    {"id": "lscpu", "kind": "parity", "maps_to": ["hardware.cpu"]},
    {"id": "nproc", "kind": "parity", "maps_to": ["hardware.cpu"]},
    {"id": "free -b", "kind": "parity", "maps_to": ["hardware.memory"]},
    {"id": "cat /sys/fs/cgroup/memory.max", "kind": "parity", "maps_to": ["hardware.memory"]},
    {"id": "nvidia-smi", "kind": "parity", "maps_to": ["hardware.gpu", "software.gpu_stack"]},
    {"id": "nvcc --version", "kind": "parity", "maps_to": ["software.gpu_stack"]},
    {"id": "python --version", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "python3 --version", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "python3 -m pip --version", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "which -a python python3 pip pip3", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "node --version", "kind": "parity", "maps_to": ["software.runtimes"]},
    {"id": "npm --version", "kind": "parity", "maps_to": ["software.package_managers"]},
    {"id": "apt --version", "kind": "parity", "maps_to": ["software.package_managers"]},
    {"id": "brew --version", "kind": "parity", "maps_to": ["software.package_managers"]},
    {"id": "git --version", "kind": "parity", "maps_to": ["software.tools"]},
    {"id": "docker --version", "kind": "parity", "maps_to": ["development.containers"]},
    {"id": "$PSVersionTable.PSVersion", "kind": "parity", "maps_to": ["system.shell"]},
    {"id": "Get-CimInstance Win32_OperatingSystem | Select-Object Caption, Version, OSArchitecture, FreePhysicalMemory", "kind": "parity", "maps_to": ["system.os", "hardware.memory"]},
    {"id": "Get-CimInstance Win32_Processor | Select-Object Name, NumberOfLogicalProcessors", "kind": "parity", "maps_to": ["hardware.cpu"]},
    {"id": "Get-CimInstance Win32_ComputerSystem | Select-Object TotalPhysicalMemory", "kind": "parity", "maps_to": ["hardware.memory"]},
    {"id": "Get-Command python, python3, py, pip -All -ErrorAction SilentlyContinue | Select-Object Name, Version, Source", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "py --list", "kind": "parity", "maps_to": ["software.python"]},
    {"id": "winget --version", "kind": "parity", "maps_to": ["software.package_managers"]},
    {"id": "hostname", "kind": "extra", "maps_to": []},
    {"id": "date -u", "kind": "extra", "maps_to": []},
    {"id": "Get-Date -Format o", "kind": "extra", "maps_to": []},
    {"id": "echo $PATH", "kind": "extra", "maps_to": []},
    {"id": "$env:Path", "kind": "extra", "maps_to": []},
    {"id": "df -h .", "kind": "extra", "maps_to": []},
    {"id": "wsl --list --verbose", "kind": "extra", "maps_to": []}
  ]
}
