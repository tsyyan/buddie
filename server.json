{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tsyyan/buddie",
  "title": "Buddie — AI Agent Reliability Toolkit",
  "description": "AI Agent Reliability Toolkit: evidence checks, feedback and permission-controlled local diagnostics.",
  "repository": {
    "url": "https://github.com/tsyyan/buddie",
    "source": "github"
  },
  "websiteUrl": "https://github.com/tsyyan/buddie",
  "version": "2.0.4",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "buddie",
      "version": "2.0.4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "BUDDIE_GITHUB_TOKEN",
          "description": "Optional GitHub token for pr: and ci: anchors (higher rate limit, private repos)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "VERBATIM_STORE",
          "description": "Folder for page snapshots (default ./.verbatim)",
          "isRequired": false
        }
      ]
    }
  ]
}
