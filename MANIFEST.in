# The sdist is the package plus what a reader of it needs; experiment data stays in the repository.
include packaging/README.md LICENSE NOTICE PRIVACY.md run.py
prune releases
prune experiments
prune results
prune tests
prune examples
prune docs
prune scripts
prune assets
prune hooks
prune skills
global-exclude __pycache__ *.py[cod]

exclude README.md
