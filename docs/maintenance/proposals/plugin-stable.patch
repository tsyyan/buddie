+
+  plugin-stable:
+    # the authorized candidate's compact plugin onto the distribution branch, only when chosen by hand; the commit,
+    # its source commit and package SHA-256 go to the run summary. A plain push: a moved branch rejects it
+    needs: authorize
+    if: inputs.only == 'plugin-stable'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      actions: read
+    env:
+      V: ${{ needs.authorize.outputs.version }}
+      CLAUDE_CLI: "@anthropic-ai/claude-code@2.1.310"
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
+        with:
+          fetch-depth: 0
+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093  # v4.3.0
+        with:
+          name: release-candidate
+          path: rc/
+          run-id: ${{ inputs.candidate }}
+          github-token: ${{ github.token }}
+      - name: the candidate's plugin, unchanged and rebuilt identically from the tag's commit
+        run: |
+          python3 scripts/release_manifest.py verify rc --version "$V" --commit "$GITHUB_SHA"
+          python3 scripts/plugin_package.py verify rc/plugin --ref "$GITHUB_SHA"
+      - name: promote, or find it already promoted
+        env:
+          CREATE: ${{ inputs.create_branch }}
+        run: |
+          flag=""; [ "$CREATE" = true ] && flag="--create"
+          python3 scripts/plugin_promote.py promote rc --version "$V" --source "$GITHUB_SHA" $flag > promotion.json
+          { echo "### plugin-stable"; echo; echo '```json'; cat promotion.json; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
+      - name: the branch is exactly the package, and it installs and runs
+        run: |
+          commit=$(python3 -c "import json; print(json.load(open('promotion.json'))['commit'])")
+          git fetch --quiet origin plugin-stable
+          test "$(git rev-parse FETCH_HEAD)" = "$commit" || { echo "::error::plugin-stable is not $commit"; exit 1; }
+          python3 scripts/plugin_promote.py verify --commit "$commit" --manifest rc/plugin/plugin-manifest.json
+          mkdir "$RUNNER_TEMP/stable" && git archive "$commit" | tar -x -C "$RUNNER_TEMP/stable"
+          export CLAUDE_CONFIG_DIR="$RUNNER_TEMP/claude-config"
+          mkdir -p "$CLAUDE_CONFIG_DIR"
+          npx --yes "$CLAUDE_CLI" plugin validate --strict "$RUNNER_TEMP/stable"
+          npx --yes "$CLAUDE_CLI" plugin marketplace add "$RUNNER_TEMP/stable"
+          npx --yes "$CLAUDE_CLI" plugin install buddie@buddie
+          installed=$(python3 -c "import json,os; d=json.load(open(os.path.join(os.environ['CLAUDE_CONFIG_DIR'], 'plugins', 'installed_plugins.json'))); print(d['plugins']['buddie@buddie'][0]['installPath'])")
+          python3 scripts/smoke_plugin.py "$installed" --manifest rc/plugin/plugin-manifest.json
