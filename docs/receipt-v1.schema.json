{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/tsyyan/buddie#receipt-v1",
 "title": "buddie receipt-v1",
 "type": "object",
 "required": [
  "_type",
  "subject",
  "predicateType",
  "predicate"
 ],
 "additionalProperties": false,
 "properties": {
  "_type": {
   "const": "https://in-toto.io/Statement/v1"
  },
  "subject": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "digest"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "digest": {
      "type": "object",
      "required": [
       "sha256"
      ],
      "additionalProperties": false,
      "properties": {
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  },
  "predicateType": {
   "const": "https://github.com/tsyyan/buddie#receipt-v1"
  },
  "predicate": {
   "type": "object",
   "required": [
    "producer",
    "checked_at",
    "verification",
    "scope",
    "evidence"
   ],
   "additionalProperties": false,
   "properties": {
    "producer": {
     "type": "object",
     "required": [
      "buddie",
      "verbatim"
     ],
     "additionalProperties": false,
     "properties": {
      "buddie": {
       "type": "string"
      },
      "verbatim": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "checked_at": {
     "type": "string"
    },
    "verification": {
     "type": "object",
     "required": [
      "outcome",
      "numbers",
      "counts",
      "findings"
     ],
     "additionalProperties": false,
     "properties": {
      "outcome": {
       "enum": [
        "PASS",
        "FAIL",
        "GAPS",
        "UNKNOWN",
        "EMPTY",
        "NOT_RUN"
       ]
      },
      "numbers": {
       "enum": [
        "gap",
        "fail",
        "off"
       ]
      },
      "counts": {
       "type": "object",
       "required": [
        "supported",
        "contradicted",
        "no_claim",
        "undetermined",
        "unrecognized"
       ],
       "additionalProperties": false,
       "properties": {
        "supported": {
         "type": "integer",
         "minimum": 0
        },
        "contradicted": {
         "type": "integer",
         "minimum": 0
        },
        "no_claim": {
         "type": "integer",
         "minimum": 0
        },
        "undetermined": {
         "type": "integer",
         "minimum": 0
        },
        "unrecognized": {
         "type": "integer",
         "minimum": 0
        }
       }
      },
      "findings": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/finding"
       }
      }
     }
    },
    "scope": {
     "type": "object",
     "required": [
      "requested",
      "effective",
      "executed",
      "excluded",
      "coverage",
      "signals"
     ],
     "additionalProperties": false,
     "properties": {
      "requested": {
       "type": "object",
       "required": [
        "profile",
        "checks"
       ],
       "additionalProperties": false,
       "properties": {
        "profile": {
         "type": [
          "string",
          "null"
         ]
        },
        "checks": {
         "type": [
          "array",
          "null"
         ],
         "items": {
          "$ref": "#/$defs/check"
         }
        }
       }
      },
      "effective": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/check"
       }
      },
      "executed": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/check"
       }
      },
      "excluded": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "check",
         "module",
         "reason",
         "detected"
        ],
        "additionalProperties": false,
        "properties": {
         "check": {
          "$ref": "#/$defs/check"
         },
         "module": {
          "$ref": "#/$defs/module"
         },
         "reason": {
          "enum": [
           "profile",
           "gate_level",
           "call_option",
           "unavailable"
          ]
         },
         "detected": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         }
        }
       }
      },
      "coverage": {
       "enum": [
        "FULL",
        "PARTIAL",
        "UNKNOWN",
        "NONE"
       ]
      },
      "signals": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    },
    "evidence": {
     "type": "object",
     "required": [
      "provenance"
     ],
     "additionalProperties": false,
     "properties": {
      "provenance": {
       "type": "object",
       "required": [
        "caller_supplied",
        "agent_writable",
        "collector_observed",
        "unknown"
       ],
       "additionalProperties": false,
       "properties": {
        "caller_supplied": {
         "type": "integer",
         "minimum": 0
        },
        "agent_writable": {
         "type": "integer",
         "minimum": 0
        },
        "collector_observed": {
         "type": "integer",
         "minimum": 0
        },
        "unknown": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "check": {
   "enum": [
    "quote",
    "number",
    "file_anchor",
    "commit_anchor",
    "fact_anchor",
    "pr_anchor",
    "ci_anchor",
    "run_anchor",
    "choice_anchor",
    "work_claim",
    "other_anchor"
   ]
  },
  "module": {
   "enum": [
    "sources",
    "github",
    "execution"
   ]
  },
  "finding": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "check",
    "module",
    "line",
    "subject",
    "verdict",
    "fact",
    "reason",
    "decision",
    "message",
    "evidence"
   ],
   "properties": {
    "check": {
     "$ref": "#/$defs/check"
    },
    "module": {
     "$ref": "#/$defs/module"
    },
    "line": {
     "type": [
      "integer",
      "null"
     ]
    },
    "subject": {
     "type": "string"
    },
    "verdict": {
     "type": "string"
    },
    "fact": {
     "enum": [
      "supported",
      "contradicted",
      "no_claim",
      "undetermined",
      "unrecognized"
     ]
    },
    "reason": {
     "enum": [
      "found",
      "found_normalized",
      "not_in_source",
      "ambiguous_miss",
      "value_without_context",
      "only_hidden",
      "only_in_copy",
      "source_unavailable",
      "no_source",
      "not_a_citation",
      "holds",
      "broken",
      "uncheckable",
      "not_computed",
      "unsupported",
      "not_an_anchor",
      "unknown_verdict"
     ]
    },
    "decision": {
     "enum": [
      "block",
      "flag",
      "allow"
     ]
    },
    "message": {
     "type": [
      "string",
      "null"
     ]
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "locator",
       "provenance",
       "digest",
       "source",
       "observed_at"
      ],
      "properties": {
       "kind": {
        "type": "string"
       },
       "locator": {
        "type": "string"
       },
       "provenance": {
        "enum": [
         "caller_supplied",
         "agent_writable",
         "collector_observed",
         "unknown"
        ]
       },
       "digest": {
        "type": [
         "string",
         "null"
        ]
       },
       "source": {
        "type": [
         "string",
         "null"
        ]
       },
       "observed_at": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  }
 }
}
