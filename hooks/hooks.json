{
  "description": "buddie gate: a report that quotes a source it does not match, or states a repo fact that no longer holds, is sent back to the model before it leaves the session",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__hearthbot__reply|mcp__hearthbot__post_message|mcp__claude-code-remote__send_message|SendMessage",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/run.py\" hook", "timeout": 120}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/run.py\" hook", "timeout": 120}]
      }
    ]
  }
}
